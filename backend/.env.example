# ==============================================================================
# Unified Platform Backend — Example Environment Configuration
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# ---- Database (Supabase PostgreSQL / Connection String) ----
DATABASE_URL=postgresql://postgres.<project_id>:<db_password>@aws-0-<region>.pooler.supabase.com:5432/postgres
connection_string=postgresql://postgres.<project_id>:<db_password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Supabase REST API & Service Credentials ----
SUPABASE_URL=https://<project_id>.supabase.co
supabase_url=https://<project_id>.supabase.co
SUPABASE_SERVICE_KEY=e9...
service_role=e...
anon=e...s

# ---- JWT Authentication ----
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
SECRET_KEY=your_secure_jwt_secret_key_here

# ---- Groq (LLM Orchestrator & Evaluation Provider) ----
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEYS_POOL=gsk_optional_key_1,gsk_optional_key_2
GROQ_ENDPOINT=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_CHAT_ENDPOINT=https://api.groq.com/openai/v1
OPENAI_CHAT_MODEL=llama-3.3-70b-versatile

# ---- Local Ollama (Local Evaluator) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_NUM_CTX=8192

# ---- Google API Key (optional) ----
GOOGLE_API_KEY=AIzaSy...

# ---- Temporal Server ----
TEMPORAL_HOST=localhost:7233

# ---- Registry / CLI ----
ARCTL=/usr/local/bin/arctl
DAEMON_URL=http://localhost:12121
PASS_RATE_THRESHOLD=0.75
